    "url": "git+https://github.com/zdforever/dsh-plugin-telegram.git"
  },
  "homepage": "https://github.com/zdforever/dsh-plugin-telegram#readme",
  "bugs": {
    "url": "https://github.com/zdforever/dsh-plugin-telegram/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "author": "zdforever",
  "license": "MIT"
